# Copy to .env.dist and fill in. Used only by docker-compose.dist.yml.

# Required
POSTGRES_PASSWORD=
JWT_SECRET=            # openssl rand -hex 32
ENCRYPTION_KEY=        # openssl rand -hex 32 — encrypts stored registry credentials; changing it orphans them

# Where users reach the stack
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
# Session cookie gets the Secure flag only when WEB_ORIGIN is https://. Override: true/false
COOKIE_SECURE=
# Public IP of this server, used by the domain DNS check (auto-detected via api.ipify.org when empty)
PUBLIC_IP=
# Path whose filesystem the dashboard storage chart reports (default: / — in Docker that is the host disk behind /var/lib/docker)
STORAGE_PATH=

# Optional: serve aoox itself on your own domain through the built-in proxy.
# Two ways to set this up:
#   1. Manual: add -f docker-compose.domain.yml (see its header), point both DNS
#      records at this host, set PROXY_ACME_EMAIL below, then switch the URLs
#      above to https:
#        WEB_DOMAIN=panel.example.com  API_DOMAIN=api.panel.example.com
#        WEB_ORIGIN=https://panel.example.com  PUBLIC_API_URL=https://api.panel.example.com
#   2. From the dashboard: set INSTALL_DIR below, start the stack once, then use
#      Settings -> "Domain panel" (owner only) — it writes
#      docker-compose.override.yml here and restarts web/api for you; this
#      section's variables then reflect what it applied.
# Either way, WEB_ORIGIN must match the domain in the browser or the terminal
# rejects the connection ("origin not allowed").
WEB_DOMAIN=
API_DOMAIN=
# Absolute path, ON THIS HOST, of the folder containing this file — required
# only for option 2 above (the API bind-mounts it into a helper container to
# write files and re-run `docker compose up` here without SSH access).
INSTALL_DIR=

# Optional: non-interactive onboarding (only when the users table is empty)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional: pin a specific version instead of latest (images: hideandseeklab/aoox-api, hideandseeklab/aoox-web on Docker Hub)
# API_IMAGE=hideandseeklab/aoox-api:0.1.0-alpha.0
# WEB_IMAGE=hideandseeklab/aoox-web:0.1.0-alpha.0

# Web terminal -> shell on the HOST over SSH (leave TERMINAL_SSH_HOST empty to
# get a shell inside the api container instead).
#   1. Enable an SSH server on the host (Linux: sshd; Windows: OpenSSH Server feature).
#   2. Set TERMINAL_SSH_USER to the host user the terminal should log in as.
#   3. The API generates a keypair into ./secrets on first use. Open
#      Settings -> Terminal (or the terminal itself) and run the shown
#      command on the host once to add the key to that user's authorized_keys.
TERMINAL_SSH_HOST=host.docker.internal
TERMINAL_SSH_PORT=22
TERMINAL_SSH_USER=
# Optional: bring your own key instead of the generated one
TERMINAL_SSH_PRIVATE_KEY_FILE=
TERMINAL_SSH_PASSPHRASE=
# Or, instead of a key (less secure):
TERMINAL_SSH_PASSWORD=

# Docker engine access for the api container (registry provisioning, deployments).
# gid of /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock  (Linux, often 999 or 0)
DOCKER_GID=0

# Self-hosted registry (container `aoox-registry`, image registry:3)
REGISTRY_PORT=5000
# Host that `docker push` uses. localhost is exempt from Docker's insecure-registry rule;
# any other host needs TLS (reverse proxy) or an `insecure-registries` entry in daemon.json.
REGISTRY_PUBLIC_HOST=localhost

# Reverse proxy (Traefik) for application domains — provision it on the Settings page.
# Ports 80/443 on the host must be free. Set PROXY_ACME_EMAIL to enable Let's Encrypt;
# with it set, https app domains (and WEB_DOMAIN/API_DOMAIN) redirect http -> https.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
PROXY_ACME_EMAIL=
PROXY_ACME_STAGING=false

# Log rotation for every container aoox starts (app, database, proxy, registry):
# json-file driver with max-size/max-file. `off` keeps Docker's default (unbounded).
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILE=3

# How long hourly metric rollups are kept (minute rollups: 48 hours).
METRICS_RETENTION_DAYS=30

# Railpack build type: pinned CLI/BuildKit versions and how much BuildKit cache to keep.
RAILPACK_VERSION=0.39.0
BUILDKIT_VERSION=v0.27.0
BUILDKIT_CACHE_KEEP_GB=10
