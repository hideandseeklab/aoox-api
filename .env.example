PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=aoox
DB_PASSWORD=aoox
DB_NAME=aoox
# Apply pending migrations on startup (set to true in containers)
DB_MIGRATIONS_RUN=false

# Auth — JWT_SECRET is required; generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin of aoox-web (CORS + Socket.IO origin check)
WEB_ORIGIN=http://localhost:3000

# Optional non-interactive onboarding: creates the owner account on first boot
# when no user exists yet. Leave empty to use the /setup page instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Web terminal target. Leave TERMINAL_SSH_HOST empty to spawn a local shell next
# to the API (dev / bare-metal). In Docker, set it so the terminal reaches the
# HOST over SSH instead of the container.
TERMINAL_SSH_HOST=
TERMINAL_SSH_PORT=22
TERMINAL_SSH_USER=
# Credential precedence: key content (\n for newlines) / key file / password.
# With none set, the API generates its own ed25519 key in TERMINAL_SSH_KEY_DIR
# (default ./secrets) and shows the authorized_keys command in Settings.
TERMINAL_SSH_PRIVATE_KEY=
TERMINAL_SSH_PRIVATE_KEY_FILE=
TERMINAL_SSH_PASSPHRASE=
TERMINAL_SSH_PASSWORD=
TERMINAL_SSH_KEY_DIR=

# Encrypts stored registry credentials (dedicated key; rotating it orphans stored passwords). openssl rand -hex 32
ENCRYPTION_KEY=

# Docker engine (default: /var/run/docker.sock, or //./pipe/docker_engine on Windows)
DOCKER_SOCKET=

# Self-hosted registry (registry:3 container managed by the API)
REGISTRY_PORT=5000
# Host clients use in `docker push` (localhost is exempt from the insecure-registry rule)
REGISTRY_PUBLIC_HOST=localhost
# How the API itself reaches it (in Docker: http://host.docker.internal:5000)
REGISTRY_INTERNAL_URL=

# Reverse proxy (Traefik) managed by the API
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# Enables Let's Encrypt when set
PROXY_ACME_EMAIL=
PROXY_ACME_STAGING=false
# Host path of the docker socket to mount into Traefik (Windows dev: //var/run/docker.sock)
PROXY_DOCKER_SOCKET=/var/run/docker.sock

# Where git providers reach this API for webhooks (defaults to http://localhost:PORT)
PUBLIC_API_URL=
# Public IP domains must point at (DNS check). Auto-detected via api.ipify.org when empty.
PUBLIC_IP=
# Path whose filesystem the dashboard storage chart reports (default: / — in Docker that is the host disk behind /var/lib/docker)
STORAGE_PATH=

# Log rotation for every container aoox starts (app, database, proxy, registry):
# json-file driver with max-size/max-file. `off` keeps Docker's default (unbounded).
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILE=3

# How long hourly metric rollups are kept (minute rollups: 48 hours).
METRICS_RETENTION_DAYS=30

# Railpack build type: pinned CLI/BuildKit versions and how much BuildKit cache to keep.
RAILPACK_VERSION=0.39.0
BUILDKIT_VERSION=v0.27.0
BUILDKIT_CACHE_KEEP_GB=10
